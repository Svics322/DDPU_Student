{% extends "layout.njk" %}

{% block content %}
<div style="max-width: 440px; margin: 40px auto;">
  <div class="card">
    <h2 class="section-title" style="margin-bottom: 6px;">Вхід до системи</h2>
    <p style="color: var(--muted); font-size: 0.88rem; margin-bottom: 20px;">
      Введіть облікові дані для авторизації
    </p>

    {% if error %}
      <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% if success %}
      <div class="alert alert-success">{{ success }}</div>
    {% endif %}

    <form action="/login" method="POST" novalidate>
      <div class="form-group">
        <label for="username">Логін</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          value="{{ formData.username }}" 
          placeholder="Введіть логін"
          {% if errors.username %}class="input-error"{% endif %}
        >
        {% if errors.username %}
          <span class="error-text">{{ errors.username }}</span>
        {% endif %}
      </div>

      <div class="form-group">
        <label for="password">Пароль</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="Введіть пароль"
          {% if errors.password %}class="input-error"{% endif %}
        >
        {% if errors.password %}
          <span class="error-text">{{ errors.password }}</span>
        {% endif %}
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Увійти
        </button>
      </div>
    </form>

    <div style="margin-top: 20px; text-align: center; font-size: 0.88rem; color: var(--muted);">
      Ви студент? <a href="/register" style="color: var(--primary); font-weight: 500;">Зареєструватися</a>
    </div>
  </div>

  <div class="card" style="background: #f8fafc; border-style: dashed; padding: 18px 20px;">
    <h4 style="font-size: 0.88rem; font-weight: 600; margin-bottom: 8px; color: #334155;">
      Тестові облікові записи для перевірки:
    </h4>
    <ul style="padding-left: 18px; font-size: 0.85rem; color: #475569; line-height: 1.6;">
      <li><strong>admin</strong> / <code>admin123</code> — повний доступ до всіх розділів системи та реєстрація викладачів.</li>
      <li><strong>teacher</strong> / <code>teacher123</code> — викладач Гольський В.Б. (доступ лише до власних дисциплін та своїх студентів).</li>
      <li><strong>visitor</strong> / <code>visitor123</code> — студент Юрків В.Р. (перегляд власного навчального плану, курсів та оцінок).</li>
    </ul>
  </div>
</div>
{% endblock %}
