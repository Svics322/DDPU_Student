{# Модальне вікно керування доступом викладача до дисципліни #}
<div id="accessControlModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="max-width: 600px; width: 100%; margin: 0; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px;">
      <h3 style="margin: 0; font-size: 1.2rem; color: #0f172a; font-weight: 700;">
        Керування доступом викладача до дисципліни
      </h3>
      <button type="button" onclick="closeAccessModal()" style="background: none; border: none; font-size: 1.4rem; line-height: 1; cursor: pointer; color: #94a3b8;">&times;</button>
    </div>

    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px 16px; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.6;">
      <div>Викладач: <strong id="modalTeacherName" style="color: #0f172a;"></strong> (<span id="modalDepartmentName" style="color: #475569;"></span>)</div>
      <div>Дисципліна: <strong id="modalSubjectName" style="color: #1e3a8a;"></strong></div>
      <div style="margin-top: 4px;">Поточний статус: <span id="modalStatusBadge"></span></div>
      
      <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed #cbd5e1; font-size: 0.85rem; color: #475569;">
        <div>Діючі закріплення за курсами: <span id="modalAssignmentsInfo" style="font-weight: 600; color: #0f172a;"></span></div>
        <div style="margin-top: 2px;">Залучені співвикладачі: <span id="modalCoTeachersInfo" style="font-weight: 600; color: #0f172a;"></span></div>
      </div>
    </div>

    <form id="accessControlForm" action="/admin/subject-requests/revoke-access" method="POST">
      <input type="hidden" id="formRequestId" name="requestId" value="">
      <input type="hidden" id="formTeacherId" name="teacherId" value="">
      <input type="hidden" id="formSubjectId" name="subjectId" value="">

      <div style="margin-bottom: 16px;">
        <label style="font-weight: 600; font-size: 0.92rem; margin-bottom: 8px; display: block;">
          Оберіть адміністративне рішення:
        </label>

        <!-- Варіант 1: Обмежити доступ -->
        <label id="optRestrictLabel" style="display: flex; gap: 12px; padding: 12px; border: 1px solid #fde68a; border-radius: 8px; margin-bottom: 10px; cursor: pointer; background: #fffbeb;">
          <input type="radio" name="actionType" id="optRestrict" value="restrict_new" checked style="margin-top: 3px;">
          <div>
            <div style="font-weight: 600; color: #0f172a; font-size: 0.92rem;">
              Обмежити доступ (заборонити нові семестри)
            </div>
            <div style="font-size: 0.83rem; color: #64748b; margin-top: 2px; line-height: 1.4;">
              Забороняє відкривати нові семестри, закріплювати нові групи та запрошувати колег до цієї дисципліни. Можливість виставляти оцінки в уже закріплених семестрах зберігається.
            </div>
          </div>
        </label>

        <!-- Варіант 2: Повне відкликання доступу -->
        <label id="optRevokeLabel" style="display: flex; gap: 12px; padding: 12px; border: 1px solid #fca5a5; border-radius: 8px; margin-bottom: 6px; cursor: pointer; background: #fff5f5;">
          <input type="radio" name="actionType" id="optRevoke" value="revoke_full" style="margin-top: 3px;">
          <div>
            <div style="font-weight: 600; color: #991b1b; font-size: 0.92rem;">
              Повне відкликання доступу (закрити доступ до семестрів)
            </div>
            <div style="font-size: 0.83rem; color: #7f1d1d; margin-top: 2px; line-height: 1.4;">
              Повне припинення викладання. Усі діючі закріплення за курсами скасовуються, доступ до журналу оцінок блокується.
            </div>
          </div>
        </label>

        <!-- Опція для співвикладачів -->
        <div id="revokeCoTeachersWrap" style="display: none; margin-left: 28px; margin-bottom: 12px; padding: 10px 14px; background: #fff1f2; border: 1px dashed #fecdd3; border-radius: 6px;">
          <label style="display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: #9f1239; cursor: pointer; margin: 0;">
            <input type="checkbox" name="disconnectCoTeachers" id="disconnectCoTeachers" value="true" checked>
            <span>Також від'єднати залучених співвикладачів від курсів цієї дисципліни</span>
          </label>
          <div style="font-size: 0.76rem; color: #be123c; margin-top: 3px; margin-left: 22px;">
            Якщо зняти позначку, запрошені співвикладачі продовжать вести свої підгрупи
          </div>
        </div>

        <!-- Варіант 3: Поновити повний доступ -->
        <label id="optRestoreLabel" style="display: none; gap: 12px; padding: 12px; border: 1px solid #86efac; border-radius: 8px; margin-bottom: 10px; cursor: pointer; background: #f0fdf4;">
          <input type="radio" name="actionType" id="optRestore" value="restore_full" style="margin-top: 3px;">
          <div>
            <div style="font-weight: 600; color: #166534; font-size: 0.92rem;">
              Поновити повний доступ
            </div>
            <div style="font-size: 0.83rem; color: #14532d; margin-top: 2px; line-height: 1.4;">
              Повертає викладачу право планувати нові семестри, закріплювати академічні групи та запрошувати співвикладачів до дисципліни.
            </div>
          </div>
        </label>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <label for="adminComment" style="font-size: 0.88rem; font-weight: 600;">Примітка або розпорядження деканату (опціонально)</label>
        <input 
          type="text" 
          id="adminComment" 
          name="adminComment" 
          placeholder="Наприклад: Наказ ректорату №45 від 22.10.2026"
          style="font-size: 0.88rem;"
        >
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" onclick="closeAccessModal()" class="btn btn-outline">Скасувати</button>
        <button type="submit" class="btn btn-primary" id="modalSubmitBtn">
          Застосувати рішення
        </button>
      </div>
    </form>
  </div>
</div>
