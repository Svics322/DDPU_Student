{# Компонент полів вводу форм #}

{% macro textInput(id, name, label, value, error, placeholder, isRequired, hint) %}
  <div class="form-group">
    {% if label %}
      <label for="{{ id or name }}">
        {{ label }}
        {% if isRequired %}<span style="color: var(--danger);">*</span>{% endif %}
      </label>
    {% endif %}
    <input 
      type="text" 
      id="{{ id or name }}" 
      name="{{ name }}" 
      value="{{ value or '' }}" 
      {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
      {% if error %}class="input-error"{% endif %}
    >
    {% if hint %}
      <div style="font-size: 0.78rem; color: #64748b; margin-top: 3px;">{{ hint }}</div>
    {% endif %}
    {% if error %}
      <span class="error-text">{{ error }}</span>
    {% endif %}
  </div>
{% endmacro %}

{% macro numberInput(id, name, label, value, error, min, max, placeholder, isRequired, hint) %}
  <div class="form-group">
    {% if label %}
      <label for="{{ id or name }}">
        {{ label }}
        {% if isRequired %}<span style="color: var(--danger);">*</span>{% endif %}
      </label>
    {% endif %}
    <input 
      type="number" 
      id="{{ id or name }}" 
      name="{{ name }}" 
      value="{{ value if value !== null and value !== undefined else '' }}" 
      {% if min !== undefined %}min="{{ min }}"{% endif %}
      {% if max !== undefined %}max="{{ max }}"{% endif %}
      {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
      {% if error %}class="input-error"{% endif %}
    >
    {% if hint %}
      <div style="font-size: 0.78rem; color: #64748b; margin-top: 3px;">{{ hint }}</div>
    {% endif %}
    {% if error %}
      <span class="error-text">{{ error }}</span>
    {% endif %}
  </div>
{% endmacro %}

{% macro dateInput(id, name, label, value, error, min, max, isRequired, hint) %}
  <div class="form-group">
    {% if label %}
      <label for="{{ id or name }}">
        {{ label }}
        {% if isRequired %}<span style="color: var(--danger);">*</span>{% endif %}
      </label>
    {% endif %}
    <input 
      type="date" 
      id="{{ id or name }}" 
      name="{{ name }}" 
      value="{{ value or '' }}" 
      {% if min %}min="{{ min }}"{% endif %}
      {% if max %}max="{{ max }}"{% endif %}
      {% if error %}class="input-error"{% endif %}
    >
    {% if hint %}
      <div style="font-size: 0.78rem; color: #64748b; margin-top: 3px;">{{ hint }}</div>
    {% endif %}
    {% if error %}
      <span class="error-text">{{ error }}</span>
    {% endif %}
  </div>
{% endmacro %}

{% macro textarea(id, name, label, value, error, placeholder, rows) %}
  <div class="form-group">
    {% if label %}
      <label for="{{ id or name }}">{{ label }}</label>
    {% endif %}
    <textarea 
      id="{{ id or name }}" 
      name="{{ name }}" 
      rows="{{ rows or 3 }}" 
      {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
      {% if error %}class="input-error"{% endif %}
    >{{ value or '' }}</textarea>
    {% if error %}
      <span class="error-text">{{ error }}</span>
    {% endif %}
  </div>
{% endmacro %}
