{% extends "layout.njk" %}

{% block content %}
<div class="card" style="max-width: 560px; margin: 30px auto;">
  <div style="margin-bottom: 20px;">
    <div style="margin-bottom: 8px;">
      <a href="/teacher/courses/{{ assignment.AssignmentID }}/students" class="btn btn-outline btn-sm">
        &larr; Назад до списку студентів
      </a>
    </div>
    <h1 class="section-title" style="margin-bottom: 4px;">
      {% if isEdit %}Редагування оцінки{% else %}Виставлення семестрової оцінки{% endif %}
    </h1>
    <p style="color: var(--muted); font-size: 0.88rem;">
      Студент: <strong>{{ student.FullName }}</strong> | Група: <strong>{{ assignment.group.GroupName }}</strong>
    </p>
  </div>

  <div class="info-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 20px;">
    <div class="info-box" style="padding: 10px 14px;">
      <div class="info-label">Дисципліна</div>
      <div style="font-weight: 600; font-size: 0.92rem; color: #1e293b;">
        {{ assignment.subject.SubjectName }}
      </div>
    </div>
    <div class="info-box" style="padding: 10px 14px;">
      <div class="info-label">Навчальний період</div>
      <div style="font-weight: 600; font-size: 0.92rem; color: #1e293b;">
        {{ assignment.AcademicYear }} ({{ assignment.Semester }} сем.)
      </div>
    </div>
  </div>

  <form action="{% if isEdit %}/teacher/courses/{{ assignment.AssignmentID }}/grades/edit/{{ gradeId }}{% else %}/teacher/courses/{{ assignment.AssignmentID }}/grades/create/{{ student.StudentID }}{% endif %}" method="POST" novalidate>
    <div class="form-group">
      <label for="controlTypeId">Вид семестрового контролю</label>
      <select id="controlTypeId" name="controlTypeId" {% if errors.controlTypeId %}class="input-error"{% endif %}>
        <option value="">-- Оберіть вид контролю --</option>
        {% for ct in controlTypes %}
          {% set isTaken = (not isEdit) and (takenControlTypeIds and (ct.ControlTypeID in takenControlTypeIds)) %}
          <option 
            value="{{ ct.ControlTypeID }}" 
            {% if isTaken %}disabled style="color: #94a3b8;"{% endif %}
            {% if formData.controlTypeId == ct.ControlTypeID and not isTaken %}selected{% endif %}
          >
            {{ ct.ControlTypeName }}
          </option>
        {% endfor %}
      </select>
      {% if errors.controlTypeId %}
        <span class="error-text">{{ errors.controlTypeId }}</span>
      {% endif %}
    </div>

    <div class="form-group">
      <label for="assessmentDate">Дата проведення оцінювання <span style="color: var(--danger);">*</span></label>
      <input 
        type="date" 
        id="assessmentDate" 
        name="assessmentDate" 
        value="{{ formData.assessmentDate }}" 
        {% if semester and semester.StartDate %}min="{{ semester.StartDate }}"{% endif %}
        {% if semester and semester.EndDate %}max="{{ semester.EndDate }}"{% endif %}
        {% if errors.assessmentDate %}class="input-error"{% endif %}
      >
      {% if semester and semester.StartDate and semester.EndDate %}
        <div style="font-size: 0.76rem; color: #64748b; margin-top: 3px;">
          Термін семестру: з {{ semester.StartDate }} по {{ semester.EndDate }}
        </div>
      {% endif %}
      {% if errors.assessmentDate %}
        <span class="error-text">{{ errors.assessmentDate }}</span>
      {% endif %}
    </div>

    <div class="form-group">
      <label for="mark">Оцінка за 100-бальною шкалою (0 - 100)</label>
      <input 
        type="number" 
        id="mark" 
        name="mark" 
        value="{{ formData.mark }}" 
        placeholder="Наприклад: 95"
        {% if errors.mark %}class="input-error"{% endif %}
      >
      {% if errors.mark %}
        <span class="error-text">{{ errors.mark }}</span>
      {% endif %}
    </div>

    <div style="display: flex; gap: 10px; margin-top: 24px;">
      <button type="submit" class="btn btn-primary">
        {% if isEdit %}Зберегти зміни{% else %}Внести оцінку до відомості{% endif %}
      </button>
      <a href="/teacher/courses/{{ assignment.AssignmentID }}/students" class="btn btn-outline">
        Скасувати
      </a>
    </div>
  </form>
</div>
{% endblock %}
