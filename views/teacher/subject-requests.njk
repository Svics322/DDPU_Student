{% extends "layout.njk" %}
{% from "components/alerts.njk" import alerts %}
{% from "components/status-badges.njk" import requestBadge %}

{% block content %}
<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
      <div style="margin-bottom: 8px;">
        <a href="/teacher/courses" class="btn btn-outline btn-sm">&larr; До панелі курсів</a>
      </div>
      <h1 class="section-title" style="margin-bottom: 4px;">Заявки на доступ до навчальних дисциплін</h1>
      <p style="color: var(--muted); font-size: 0.9rem;">
        Подання запитів на закріплення предметів за викладачем та відстеження рішень адміністрації
      </p>
    </div>

    <div>
      <a href="/teacher/courses/create" class="btn btn-outline">
        + Створити курс зі схвалених
      </a>
    </div>
  </div>

  {{ alerts(successMessage, errorMessage) }}

  <!-- Форма подання нової заявки -->
  <div style="background: #f8fafc; border: 1px solid var(--border-light); border-radius: 6px; padding: 20px; margin-bottom: 32px;">
    <h3 style="font-size: 1.05rem; font-weight: 600; color: #1e3a8a; margin-bottom: 12px;">
      Подати нову заявку на викладання дисципліни
    </h3>

    <form action="/teacher/subject-requests" method="POST" novalidate>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group" style="margin-bottom: 0;">
          <label for="subjectId">Навчальна дисципліна</label>
          <select 
            id="subjectId" 
            name="subjectId" 
            class="{% if errors.subjectId %}input-error{% endif %}"
          >
            <option value="">-- Оберіть дисципліну --</option>
            {% for s in allSubjects %}
              {% set reqInfo = subjectStatusMap[s.SubjectID] %}
              {% set isUnavailable = (reqInfo and (reqInfo.Status == 'approved' or reqInfo.Status == 'pending')) %}
              <option 
                value="{{ s.SubjectID }}" 
                {% if isUnavailable %}disabled style="color: #94a3b8;"{% endif %}
                {% if formData.subjectId == s.SubjectID and not isUnavailable %}selected{% endif %}
              >
                {{ s.SubjectName }}
              </option>
            {% endfor %}
          </select>
          {% if errors.subjectId %}
            <span class="error-text">{{ errors.subjectId }}</span>
          {% endif %}
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="comment">Обґрунтування / Досвід викладання (коментар)</label>
          <input 
            type="text" 
            id="comment" 
            name="comment" 
            value="{{ formData.comment }}" 
            placeholder="Наприклад: Маю наукові публікації та досвід викладання курсу"
          >
        </div>
      </div>

      <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
        <button type="submit" class="btn btn-primary btn-sm">
          Надіслати заявку адміністрації
        </button>
      </div>
    </form>
  </div>

  <!-- Список моїх заявок -->
  <h2 class="sub-section-title" style="margin-top: 0;">Історія поданих заявок</h2>

  {% if (myRequests | length) == 0 %}
    <div class="alert alert-info" style="margin-top: 14px;">
      Ви ще не подали жодної заявки на доступ до дисциплін.
    </div>
  {% else %}
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Дисципліна</th>
            <th>Дата подання</th>
            <th>Статус</th>
            <th>Ваше обґрунтування</th>
            <th>Рішення / Коментар адміністратора</th>
            <th style="text-align: center;">Дія</th>
          </tr>
        </thead>
        <tbody>
          {% for r in myRequests %}
            <tr>
              <td>
                <strong>{{ r.subject.SubjectName }}</strong>
              </td>
              <td>{{ r.CreatedAt | default("—") }}</td>
              <td>
                {{ requestBadge(r.Status) }}
              </td>
              <td style="font-size: 0.88rem; color: #334155;">
                {{ r.Comment or "—" }}
              </td>
              <td style="font-size: 0.88rem; color: #334155;">
                {{ r.AdminComment or "—" }}
              </td>
              <td style="text-align: center;">
                {% if r.Status == 'approved' %}
                  <a href="/teacher/courses/create" class="btn btn-primary btn-sm">
                    Створити курс
                  </a>
                {% else %}
                  <span style="color: var(--muted); font-size: 0.82rem;">—</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
