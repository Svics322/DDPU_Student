{% extends "layout.njk" %}
{% from "components/grade-badge.njk" import gradeBadge %}

{% block content %}
<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
    <div>
      <h1 class="section-title" style="margin-bottom: 4px;">{{ title }}</h1>
      <p style="color: var(--muted); font-size: 0.9rem;">
        Зведені результати семестрового контролю та підсумкового оцінювання студентів
      </p>
    </div>

    {% if currentUser.role == 'admin' %}
      <a href="/admin/tables/success_rate/create" class="btn btn-primary">
        + Внести оцінку у відомість
      </a>
    {% endif %}
  </div>

  <!-- Фільтри та пошук -->
  <div style="background-color: #f8fafc; border: 1px solid var(--border); border-radius: 4px; padding: 16px; margin-bottom: 24px;">
    <form action="/success-rates" method="GET" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
      <div style="flex: 2; min-width: 220px;">
        <label for="search" style="font-size: 0.8rem; margin-bottom: 4px;">Пошук за ПІБ студента</label>
        <input 
          type="text" 
          id="search"
          name="search" 
          placeholder="Введіть прізвище або ім'я..." 
          value="{{ search }}"
        >
      </div>

      <div style="flex: 1; min-width: 140px;">
        <label for="academicYear" style="font-size: 0.8rem; margin-bottom: 4px;">Навчальний рік</label>
        <select id="academicYear" name="academicYear">
          <option value="">Всі роки</option>
          <option value="2024-2025" {% if academicYear == '2024-2025' %}selected{% endif %}>2024-2025</option>
          <option value="2025-2026" {% if academicYear == '2025-2026' %}selected{% endif %}>2025-2026</option>
        </select>
      </div>

      <div style="flex: 1; min-width: 120px;">
        <label for="semester" style="font-size: 0.8rem; margin-bottom: 4px;">Семестр</label>
        <select id="semester" name="semester">
          <option value="">Всі</option>
          <option value="1" {% if semester == '1' %}selected{% endif %}>1 семестр</option>
          <option value="2" {% if semester == '2' %}selected{% endif %}>2 семестр</option>
        </select>
      </div>

      <div style="display: flex; gap: 8px;">
        <button type="submit" class="btn btn-primary btn-sm" style="height: 38px;">
          Застосувати
        </button>

        {% if search or onlyMy or academicYear or semester %}
          <a href="/success-rates" class="btn btn-outline btn-sm" style="height: 38px;">
            Скинути
          </a>
        {% endif %}

        {% if currentUser.role == 'visitor' %}
          {% if currentUser.studentId %}
            <a href="/success-rates?onlyMy=1" class="btn btn-sm {% if onlyMy %}btn-primary{% else %}btn-outline{% endif %}" style="height: 38px;">
              Тільки мої оцінки
            </a>
          {% endif %}
        {% endif %}
      </div>
    </form>
  </div>

  <!-- Таблиця оцінок -->
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th style="width: 40px;">№</th>
          <th>Студент</th>
          <th>Група / Підгрупа</th>
          <th>Дисципліна</th>
          <th>Період</th>
          <th>Вид контролю</th>
          <th>Викладач</th>
          <th>Дата</th>
          <th>Оцінка</th>
          {% if currentUser.role == 'admin' or currentUser.role == 'teacher' %}
            <th style="min-width: 170px; text-align: center; white-space: nowrap;">Дії</th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        {% for r in records %}
          {% set canManageRow = (currentUser.role == 'admin') or (currentUser.role == 'teacher' and currentUser.teacherId == r.TeacherID) %}
          <tr>
            <td>{{ loop.index }}</td>
            <td>
              <a href="/student/profile/{{ r.student.StudentID }}" style="color: var(--primary); font-weight: 600; text-decoration: none;">
                {{ r.student.FullName }}
              </a>
              <div style="font-size: 0.78rem; color: var(--muted);">
                {{ r.student.department.AbbreviatedName }}
              </div>
            </td>
            <td>
              {{ r.student.group.GroupName }}
              <div style="font-size: 0.78rem; color: var(--muted);">
                {{ r.student.Subgroup }}
              </div>
            </td>
            <td>{{ r.subject.SubjectName }}</td>
            <td>
              {{ r.AcademicYear }}
              <div style="font-size: 0.78rem; color: var(--muted);">
                {{ r.CourseYear }} курс, {{ r.Semester }} семестр
              </div>
            </td>
            <td>
              <span style="font-size: 0.82rem; color: #0369a1; font-weight: 500;">
                {{ r.controlType.ControlTypeName }}
              </span>
            </td>
            <td>{{ r.teacher.FullName }}</td>
            <td>{{ r.AssessmentDate }}</td>
            <td>
              {{ gradeBadge(r.Mark) }}
            </td>
            {% if currentUser.role == 'admin' or currentUser.role == 'teacher' %}
              <td style="text-align: center; white-space: nowrap;">
                {% if canManageRow %}
                  {% if currentUser.role == 'admin' %}
                    <a href="/admin/tables/success_rate/edit/{{ r.SuccRateID }}" class="btn btn-outline btn-sm">
                      Ред.
                    </a>
                    <button 
                      type="button" 
                      class="btn btn-danger btn-sm"
                      data-delete-url="/admin/tables/success_rate/delete/{{ r.SuccRateID }}"
                      data-delete-name="Оцінка: {{ r.student.FullName }} - {{ r.subject.SubjectName }} ({{ r.Mark }} б.)"
                    >
                      Вид.
                    </button>
                  {% else %}
                    <a href="/teacher/courses/{{ r.AssignmentID or 1 }}/grades/edit/{{ r.SuccRateID }}" class="btn btn-outline btn-sm">
                      Ред.
                    </a>
                    <button 
                      type="button" 
                      class="btn btn-danger btn-sm"
                      data-delete-url="/teacher/grades/delete/{{ r.SuccRateID }}"
                      data-delete-name="Оцінка: {{ r.student.FullName }} - {{ r.subject.SubjectName }} ({{ r.Mark }} б.)"
                    >
                      Вид.
                    </button>
                  {% endif %}
                {% else %}
                  <span style="color: var(--muted); font-size: 0.8rem;">Перегляд</span>
                {% endif %}
              </td>
            {% endif %}
          </tr>
        {% else %}
          <tr>
            <td colspan="{% if currentUser.role == 'admin' or currentUser.role == 'teacher' %}10{% else %}9{% endif %}" style="text-align: center; padding: 28px; color: var(--muted);">
              Записів не знайдено за вказаними критеріями пошуку.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
