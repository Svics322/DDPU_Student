# Скопіюйте у .env і заповніть своїми значеннями.

# sqlite (типово) або postgres
DB_DIALECT=sqlite
DB_STORAGE=app.db

PORT=3000
SESSION_SECRET=change_me_to_a_long_random_string

# Лише для DB_DIALECT=postgres
DB_NAME=student_performance
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
